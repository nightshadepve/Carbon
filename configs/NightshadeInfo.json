      "Tabs": [
        {
          "Title": "Rules",
          "Commands": [],
          "Columns": [
            {
              "Blocks": [
                {
                  "Heading": "TEAMS",
                  "Lines": [
                    {
                      "Text": "• Solo/duo only. Max team size is 2.",
                      "Tone (body, accent, warn, muted)": "body"
                    }
                  ]
                },
                {
                  "Heading": "BASES & BUILDING",
                  "Lines": [
                    {
                      "Text": "• No raiding, damaging, griefing, laddering, walling in, trapping, or messing with player bases outside the PvP weekend and Purge.",
                      "Tone (body, accent, warn, muted)": "warn"
                    },
                    {
                      "Text": "• PvP weekend is Friday 8:00 PM to Monday 3:00 AM Eastern.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "• Purge is Tuesday of wipe week at 2:00 PM Eastern until the Thursday wipe.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "• Do not block roads, monuments, caves, vendors, event areas, or another player's build.",
                      "Tone (body, accent, warn, muted)": "warn"
                    },
                    {
                      "Text": "• Build for style, defense, roleplay, and deeply suspicious architecture. That part is encouraged.",
                      "Tone (body, accent, warn, muted)": "body"
                    }
                  ]
                },
                {
                  "Heading": "LOOT & OWNERSHIP",
                  "Lines": [
                    {
                      "Text": "• Do not take from another player's boxes, furnaces, or TC storage.",
                      "Tone (body, accent, warn, muted)": "warn"
                    },
                    {
                      "Text": "• You, your teammate, TC auth, or someone you /share with can open them.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "• Sleeping players cannot be looted, including during PvP weekend and Purge.",
                      "Tone (body, accent, warn, muted)": "warn"
                    },
                    {
                      "Text": "• Event loot is open to anyone and is not locked.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "• Hacked crates, supply drops, and heli or Bradley crates from events are public.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "• If a base box says the loot is not yours, it is not yours.",
                      "Tone (body, accent, warn, muted)": "warn"
                    }
                  ]
                },
                {
                  "Heading": "PVP",
                  "Lines": [
                    {
                      "Text": "• Monuments and events are always PvP.",
                      "Tone (body, accent, warn, muted)": "warn"
                    },
                    {
                      "Text": "• Raiding and PvP are allowed during the PvP weekend and during Purge.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "• Outside those, do not attack, bait, exploit rules, or play loophole lawyer.",
                      "Tone (body, accent, warn, muted)": "warn"
                    }
                  ]
                },
                {
                  "Heading": "COMMUNITY",
                  "Lines": [
                    {
                      "Text": "• No hate speech, harassment, stalking, threats, doxxing, slurs, cheating, exploiting, or ban evading.",
                      "Tone (body, accent, warn, muted)": "warn"
                    },
                    {
                      "Text": "• Trash talk can be spicy. Do not make it personal, creepy, or radioactive.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "• Admins have final say on edge cases. If you have to say \"technically,\" step away from the crime scene.",
                      "Tone (body, accent, warn, muted)": "body"
                    }
                  ]
                }
              ]
            }
          ],
