                    },
                    {
                      "Text": "• Medium: 24h after wipe. VIP: 12h.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "• Hard: 72h after wipe. VIP: 48h.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "• Expert: 120h after wipe. VIP: 96h.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "• Nightmare: 168h after wipe. VIP: 144h.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "• Do not interfere with another player's PvE raid unless the event rules allow it.",
                      "Tone (body, accent, warn, muted)": "body"
