                  "Heading": "RAIDBASE BUILDER",
                  "Lines": [
                    {
                      "Text": "• Raidbase builder access is admin-only after vetting. This is not a public toy box.",
                      "Tone (body, accent, warn, muted)": "warn"
                    },
                    {
                      "Text": "• For players approved to help build or test raidbase content.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "• Permissions are assigned by an admin only after vetting.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "• Do not share commands, bases, or access with unapproved players.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "• /raidbasestart — start a player raidbase build session",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "• /raidreadypve — mark the saved raidbase ready for PvE",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "• /raidreadypvp — mark the saved raidbase ready for PvP",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "• /raidbaseend — end the active raidbase session",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "• Build clean, playable bases with accessible paths and fair loot flow.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "• Avoid traps that softlock players, exploit terrain, or create impossible raid paths.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "• Ask an admin before making major format changes.",
                      "Tone (body, accent, warn, muted)": "body"
                    }
                  ]
                }
              ]
            }
