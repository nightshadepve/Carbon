      "Tabs": [
        {
          "Title": "Overview",
          "Commands": [
            "events",
            "eventinfo",
            "help"
          ],
          "Columns": [
            {
              "Blocks": [
                {
                  "Heading": "REGULAR EVENTS",
                  "Lines": [
                    {
                      "Text": "• Hide and Seek runs on scheduled event days when announced.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "• Purge is Tuesday of wipe week at 2:00 PM Eastern until the Thursday wipe. PvP, raiding, and base destruction are allowed serverwide.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "• Monuments and events are always PvP.",
                      "Tone (body, accent, warn, muted)": "warn"
                    },
                    {
                      "Text": "• The PvP weekend is Friday 8:00 PM to Monday 3:00 AM Eastern.",
                      "Tone (body, accent, warn, muted)": "body"
                    }
                  ]
                },
                {
                  "Heading": "SIGNALS",
                  "Lines": [
                    {
                      "Text": "• Heli and Bradley signals may have tiers, cooldowns, rewards, and team recommendations.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "• Read the signal card before you call one. Solo/duo is the server cap.",
                      "Tone (body, accent, warn, muted)": "body"
                    }
                  ]
                }
              ]
            },
            {
              "Blocks": [
                {
                  "Heading": "RAID CONTENT",
                  "Lines": [
                    {
                      "Text": "• Bradley and Heli signals are player-triggered combat events.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "• Raidable Bases are event bases, not normal player bases.",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "• Read the difficulty before you start one.",
                      "Tone (body, accent, warn, muted)": "body"
                    }
                  ]
                },
                {
                  "Heading": "HELP PAGES",
                  "Lines": [
                    {
                      "Text": "• /hordehelp — Hordes rules",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "• /raidbuilderinfo — vetted raidbase builder commands",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "• /rbinfo — raidable bases",
                      "Tone (body, accent, warn, muted)": "body"
                    },
                    {
                      "Text": "• /pvpinfo — where PvP is allowed",
                      "Tone (body, accent, warn, muted)": "body"
                    }
                  ]
                }
              ]
            }
          ],
          "Show status": false,
